# Platform and acceptance-test settings. Fill locally; never commit real values.
JUNSHI_SITE_URL=https://aicyld.com
JUNSHI_TEST_PASSWORD=

# Independent Junshi API
JUNSHI_API_MODE=mock
PORT=8788
JUNSHI_MAX_BODY_BYTES=209715200
FILE_UPLOAD_ROOT=var/uploads
FILE_UPLOAD_MAX_BYTES=26214400
# Shared MySQL (server-side only; never commit real values)
DB_DRIVER=mock
JUNSHI_MYSQL_HOST=
JUNSHI_MYSQL_PORT=3306
JUNSHI_MYSQL_USER=
JUNSHI_MYSQL_PASSWORD=
JUNSHI_MYSQL_DATABASE=aild_admin
JUNSHI_MYSQL_POOL_SIZE=5
# Shared object storage (server-side only)
FILE_STORAGE=local
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_INTERNAL_ENDPOINT=
OSS_PREFIX=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Shared provider secret file (server-side only)
AI_PROVIDER_SECRET_FILE=/etc/ai-kids-platform/provider-secrets.json