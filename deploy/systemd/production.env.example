# Junshi-only overrides. Shared MySQL credentials remain in
# /etc/ai-kids-platform/production.env and are not duplicated here.
JUNSHI_API_MODE=independent
DB_DRIVER=mysql
PORT=8790
FILE_UPLOAD_ROOT=/srv/junshi-platform/uploads
JUNSHI_MAX_BODY_BYTES=209715200

# Optional production alert webhook. Keep the real URL in
# /etc/junshi-platform/alert-webhook.env with mode 600, never in git.
JUNSHI_ALERT_WEBHOOK_URL=
JUNSHI_ALERT_WEBHOOK_FORMAT=generic